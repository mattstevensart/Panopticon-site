# Copy this file to `.env` and fill in the four values.
# `.env` is gitignored — it must never be committed.

# Your Firebase admin login (the one you use at /earlybird-admin).
# The script signs in as you so the security rules let it read the avatars.
FIREBASE_EMAIL=hello@panopticoncomic.com
FIREBASE_PASSWORD=

# Zoho mailbox that sends the messages.
# If your Zoho account has two-factor on, this must be an APP PASSWORD,
# not your normal one: Zoho Account → Security → App Passwords → Generate.
ZOHO_USER=hello@panopticoncomic.com
ZOHO_PASSWORD=
