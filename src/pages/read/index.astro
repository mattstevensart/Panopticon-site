---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="READ">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="mb-8 border-b border-p-accent/20 pb-6">
      <h1 class="font-display text-3xl md:text-4xl text-p-text tracking-wide">READ PANOPTICON</h1>
      <p class="font-body text-p-dim text-sm mt-4 max-w-2xl leading-relaxed">
        A <span class="text-p-teal">new inmate</span> joins the Panopticon; a timeless, single chamber prison where prisoners
        don't know when, or even if they are being watched. As he navigates the <span class="text-p-teal">strict codes</span> of his fellow
        convicts, he must unravel the mysteries of the facility, its <span class="text-p-teal">unseen wardens</span>, and the chilling
        possibility that to stay may be more deadly than escape.
      </p>
      <div class="w-16 h-px bg-p-accent mt-4"></div>
    </div>

    <!-- Other ways to read -->
    <div class="mb-8 flex flex-col items-center gap-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 w-full max-w-sm sm:max-w-none">
        <a href="https://embed.macroverse.com/portal/019f24d6-8833-73fa-8ca2-9b989be2a6e4"
           target="_blank"
           rel="noopener"
           class="btn-gloss btn-gloss--macroverse text-sm"
           aria-label="Read on Macroverse">
          <span>READ ON</span>
          <img src="/images/logos/macroverse-logo-white.svg" alt="Macroverse" class="btn-logo btn-logo--macroverse" />
          <span aria-hidden="true">→</span>
        </a>
        <a href="https://globalcomix.com/c/panopticon/r/3bb570cd-0d54-4e38-8adb-72bd874fb6d8"
           target="_blank"
           rel="noopener"
           class="btn-gloss btn-gloss--globalcomix text-sm"
           aria-label="Read on GlobalComix">
          <span>READ ON</span>
          <img src="/images/logos/globalcomix-mark-white.png" alt="GlobalComix" class="btn-logo btn-logo--globalcomix" />
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="font-ui text-p-dim text-sm tracking-wide text-center">
        Prefer print?
        <a href="https://www.amazon.com/Panopticon-1-Mr-Matt-Stevens/dp/B0HGNPPV7M/"
           target="_blank"
           rel="noopener"
           class="text-[#FF9900] hover:underline tracking-widest"
           aria-label="Buy the paperback on Amazon">BUY THE PAPERBACK ON<span class="whitespace-nowrap">&nbsp;<img src="/images/logos/amazon-logo-white.png" alt="Amazon" class="inline-logo" />&nbsp;→</span></a>
      </p>
    </div>

    <!-- Macroverse Reader -->
    <div class="border border-p-accent/30 bg-black" style="min-height: 80vh;">
      <iframe
        src="https://embed.macroverse.com/portal/019d9496-2048-7299-8a67-b5d88ceb30ea"
        class="w-full border-0"
        style="height: 85vh;"
        title="Read Panopticon"
        allow="fullscreen"
        allowfullscreen
      ></iframe>
    </div>

    <p class="font-ui text-p-dim/30 text-xs tracking-widest text-center mt-10">
      PANOPTICON · THE 63RD · ALL TRANSMISSIONS MONITORED
    </p>
  </div>
</Layout>
